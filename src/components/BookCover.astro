---
const { title, class: className = '' } = Astro.props as { title: string; class?: string };
---
<svg class={className} xmlns="http://www.w3.org/2000/svg" viewBox="0 0 480 720" role="img" aria-label={title}>
  <defs>
    <linearGradient id="book-cover-bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#1f4a45"/>
      <stop offset="48%" stop-color="#2f635c"/>
      <stop offset="100%" stop-color="#173833"/>
    </linearGradient>
    <linearGradient id="book-cover-line" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#e8d8b0" stop-opacity="0"/>
      <stop offset="50%" stop-color="#c9a45c"/>
      <stop offset="100%" stop-color="#e8d8b0" stop-opacity="0"/>
    </linearGradient>
    <radialGradient id="book-cover-glow" cx="70%" cy="28%" r="55%">
      <stop offset="0%" stop-color="#e8d8b0" stop-opacity=".28"/>
      <stop offset="100%" stop-color="#e8d8b0" stop-opacity="0"/>
    </radialGradient>
  </defs>
  <rect width="480" height="720" fill="url(#book-cover-bg)"/>
  <rect width="480" height="720" fill="url(#book-cover-glow)"/>
  <rect x="28" y="28" width="424" height="664" fill="none" stroke="#c9a45c" stroke-opacity=".55" stroke-width="1.25"/>
  <rect x="40" y="40" width="400" height="640" fill="none" stroke="#e8d8b0" stroke-opacity=".22" stroke-width="0.75"/>
  <text x="240" y="118" text-anchor="middle" fill="#e8d8b0" font-family="Georgia, 'Times New Roman', serif" font-size="13" letter-spacing="3.5">ESSAI SCIENTIFIQUE ILLUSTRE</text>
  <rect x="150" y="138" width="180" height="1" fill="url(#book-cover-line)"/>
  <text x="240" y="280" text-anchor="middle" fill="#faf9f6" font-family="Georgia, 'Times New Roman', serif" font-size="34" font-weight="500">Si Einstein</text>
  <text x="240" y="328" text-anchor="middle" fill="#faf9f6" font-family="Georgia, 'Times New Roman', serif" font-size="34" font-weight="500">avait eu</text>
  <text x="240" y="376" text-anchor="middle" fill="#c9a45c" font-family="Georgia, 'Times New Roman', serif" font-size="34" font-weight="500">ChatGPT</text>
  <circle cx="240" cy="470" r="34" fill="none" stroke="#c9a45c" stroke-opacity=".7" stroke-width="1"/>
  <circle cx="240" cy="470" r="18" fill="none" stroke="#e8d8b0" stroke-opacity=".45" stroke-width="1"/>
  <circle cx="248" cy="458" r="5" fill="#e8d8b0" fill-opacity=".85"/>
  <text x="240" y="560" text-anchor="middle" fill="#e8d8b0" font-family="Avenir Next, Segoe UI, sans-serif" font-size="12" letter-spacing="2.5">FRANCK MEVENGUE</text>
  <text x="240" y="590" text-anchor="middle" fill="#d8c9a4" font-family="Avenir Next, Segoe UI, sans-serif" font-size="11" letter-spacing="1.5">FR · EN · ZH · 2026</text>
</svg>
