---
import { getCollection, render } from 'astro:content';
import ReaderLayout from '@/layouts/ReaderLayout.astro';
import ProjectDocuments from '@/components/ProjectDocuments.astro';
import { entryImage, entrySlug, formatDate } from '@/lib/content';
import { localeFromId } from '@/i18n';
import { withBase } from '@/lib/url';
export async function getStaticPaths() {
  const entries = await getCollection('projects', ({ id, data }) => /^(fr|en)\//.test(id) && !data.draft);
  return entries.map((entry) => ({ params: { locale: localeFromId(entry.id), slug: entrySlug(entry) }, props: { entry } }));
}
const { entry } = Astro.props;
const locale = localeFromId(entry.id);
const { Content, headings } = await render(entry);
const meta = [entry.data.school, entry.data.year, entry.data.category, entry.data.readingTime].filter(Boolean).join(' · ');
const sourceLink = entry.data.github || entry.data.repository || entry.data.link;
---
<ReaderLayout locale={locale} title={entry.data.title} description={entry.data.description} image={entryImage(entry.data)} headings={headings} meta={meta || formatDate(entry.data.date, locale)}>
  {entry.data.metrics.length > 0 && <div class="case-metrics">{entry.data.metrics.map((metric) => <div><strong>{metric.value}</strong><span>{metric.label}</span></div>)}</div>}
  {sourceLink && <p><a class="button" href={sourceLink}>{locale === 'fr' ? 'Voir le dépôt / livrable' : 'View repository / deliverable'} ↗</a></p>}
  <Content />
  {entry.data.gallery.length > 0 && <section class="case-gallery" aria-label={locale === 'fr' ? 'Galerie du projet' : 'Project gallery'}>{entry.data.gallery.map((image, index) => <img src={withBase(image)} alt={`${entry.data.title} — ${locale === 'fr' ? 'visuel technique' : 'technical visual'} ${index + 1}`} loading="lazy" />)}</section>}
  <ProjectDocuments slot="after" documents={entry.data.documents} locale={locale} projectTitle={entry.data.title} />
</ReaderLayout>
