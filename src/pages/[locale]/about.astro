---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { locales, t, type Locale } from '@/i18n';
import { site } from '@/config/site';
import { withBase } from '@/lib/url';
import profilePhoto from '../../../photo_profil_cv.jpg';

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}
const locale = Astro.params.locale as Locale;
const copy = t(locale);
const book = site.book;
---
<BaseLayout locale={locale} title={copy.nav.about}>
  <header class="page-hero academic-page-hero">
    <div class="wrap">
      <h1>{site.name}</h1>
      <p class="lead">{locale === 'fr'
        ? 'Étudiant ingénieur en cloud, systèmes et réseaux. Je documente des architectures, des implémentations et des enseignements tirés de projets académiques.'
        : 'Engineering student in cloud, systems and networks. I document architectures, implementations and lessons from academic projects.'}</p>
      <div class="quick-links">
        <a href={`mailto:${site.email}`}>Email</a>
        <span>/</span>
        <a href={site.github}>GitHub</a>
        <span>/</span>
        <a href={site.linkedin}>LinkedIn</a>
        <span>/</span>
        <a href={withBase(`/${locale}/books/`)}>{copy.nav.books}</a>
      </div>
    </div>
  </header>

  <section class="section wrap profile-hero">
    <div class="profile-hero-copy">
      <h2 class="academic-h2">{locale === 'fr' ? 'Parcours' : 'Background'}</h2>
      <p class="profile-biography">{locale === 'fr'
        ? 'Mon parcours relie la formation multidisciplinaire de l’ECAM EPMI au Master Systems & Networks de SUPINFO Paris. Je travaille à l’intersection des infrastructures cloud, des réseaux, de l’automatisation, de la cybersécurité et des systèmes embarqués.'
        : 'My path connects multidisciplinary engineering at ECAM EPMI with the Systems & Networks Master’s programme at SUPINFO Paris. I work at the intersection of cloud infrastructure, networks, automation, cybersecurity and embedded systems.'}</p>
      <p class="profile-biography">{locale === 'fr'
        ? `J’ai également écrit l’essai « ${book.title.fr} », une réflexion sur ce qu’un modèle peut inférer à partir de traces intellectuelles — et ce qu’il ne pourra jamais reconstituer.`
        : `I also wrote the essay “${book.title.en}”, a reflection on what a model can infer from intellectual traces — and what it can never reconstruct.`}</p>
    </div>
    <figure class="profile-hero-photo">
      <img src={profilePhoto.src} width={profilePhoto.width} height={profilePhoto.height} alt={locale === 'fr' ? `Portrait de ${site.name}` : `Portrait of ${site.name}`} />
    </figure>
  </section>

  <section class="section wrap">
    <h2 class="academic-h2">{copy.education}</h2>
    <div class="education-list academic-education">
      <article>
        <time>2025 — 2027</time>
        <img src={withBase('/assets/school-supinfo-paris.png')} alt="SUPINFO Paris" />
        <div>
          <h3>Master Systems & Networks</h3>
          <p>SUPINFO Paris</p>
          <span>{locale === 'fr' ? 'Cloud · Systèmes · Réseaux · DevOps · Cybersécurité' : 'Cloud · Systems · Networks · DevOps · Cybersecurity'}</span>
        </div>
      </article>
      <article>
        <time>{locale === 'fr' ? 'Cycle ingénieur' : 'Engineering cycle'}</time>
        <img src={withBase('/assets/school-ecam-epmi.png')} alt="ECAM EPMI" />
        <div>
          <h3>{locale === 'fr' ? 'Formation d’ingénieur multidisciplinaire' : 'Multidisciplinary engineering programme'}</h3>
          <p>ECAM EPMI</p>
          <span>{locale === 'fr' ? 'Informatique · Électronique · Embarqué · Cloud · Gestion de projet' : 'Software · Electronics · Embedded · Cloud · Project management'}</span>
        </div>
      </article>
    </div>
  </section>

  <section class="section wrap">
    <h2 class="academic-h2">{locale === 'fr' ? 'Domaines' : 'Focus'}</h2>
    <p class="lead">{locale === 'fr'
      ? 'Cloud architecture · Systems · Networking · DevOps / DevSecOps · Automation · AI / Data · Embedded'
      : 'Cloud architecture · Systems · Networking · DevOps / DevSecOps · Automation · AI / Data · Embedded'}</p>
  </section>
</BaseLayout>
