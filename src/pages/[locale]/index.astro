---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PlanetPanel from '@/components/PlanetPanel.astro';
import AcademicProjectList from '@/components/AcademicProjectList.astro';
import { entrySlug, localizedCollection } from '@/lib/content';
import { locales, t, type Locale } from '@/i18n';
import { site } from '@/config/site';
import { withBase } from '@/lib/url';
import profilePhoto from '../../../photo_profil_cv.jpg';

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}
const locale = Astro.params.locale as Locale;
const copy = t(locale);
const projects = await localizedCollection('projects', locale);
const articles = (await localizedCollection('articles', locale)).slice(0, 3);
const docs = (await localizedCollection('docs', locale)).slice(0, 4);
const byNumber = (a: typeof projects[number], b: typeof projects[number]) => Number(b.data.number || 0) - Number(a.data.number || 0);
const selectedProjects = projects.filter((entry) => entry.data.featured).sort(byNumber).slice(0, 5);
const books = site.books;
const news = locale === 'fr'
  ? [
      ['Oct 2026', 'Livre 3D « Le Paradis des mathématiques » (FR · EN · AR · ZH).', withBase('/fr/books/paradis-des-mathematiques/')],
      ['Oct 2026', 'Mise à jour portfolio GitHub académique.', withBase('/fr/')],
      ['2026', 'Essai « La souveraineté du cloud européen » (FR · EN · ZH).', withBase('/fr/books/souverainete-cloud-europeenne/')],
      ['2026', 'Essai « Si Einstein avait eu ChatGPT » (version de travail).', withBase('/fr/books/si-einstein-avait-eu-chatgpt/')],
      ['2025–2027', 'Master Systems & Networks — SUPINFO Paris.', withBase('/fr/#education')],
      ['2025', 'Projets documentés : Supfile, NovaSys, MedSearchLab, Kubernetes Fleetman.', withBase('/fr/work/')],
    ]
  : [
      ['Oct 2026', '3D book “The Paradise of Mathematics” (FR · EN · AR · ZH).', withBase('/en/books/paradis-des-mathematiques/')],
      ['Oct 2026', 'Academic GitHub portfolio update.', withBase('/en/')],
      ['2026', 'Essay “European Cloud Sovereignty” (FR · EN · ZH).', withBase('/en/books/souverainete-cloud-europeenne/')],
      ['2026', 'Essay “If Einstein Had Had ChatGPT” (working draft).', withBase('/en/books/si-einstein-avait-eu-chatgpt/')],
      ['2025–2027', 'Master Systems & Networks — SUPINFO Paris.', withBase('/en/#education')],
      ['2025', 'Documented projects: Supfile, NovaSys, MedSearchLab, Kubernetes Fleetman.', withBase('/en/work/')],
    ];
---
<BaseLayout locale={locale}>
  <section class="profile-hero wrap" id="about">
    <div class="profile-hero-copy">
      <h1>{site.name}</h1>
      <p class="profile-role">{locale === 'fr'
        ? 'Étudiant ingénieur · Cloud, systèmes et réseaux'
        : 'Engineering student · Cloud, systems and networks'}</p>
      <p class="profile-biography">{locale === 'fr'
        ? 'Je construis et documente des systèmes à l’intersection des infrastructures cloud, des réseaux, de l’automatisation et de la sécurité. Mon parcours relie la formation multidisciplinaire de l’ECAM EPMI au Master Systems & Networks de SUPINFO Paris.'
        : 'I build and document systems at the intersection of cloud infrastructure, networks, automation and security. My path connects multidisciplinary engineering at ECAM EPMI with the Systems & Networks Master’s programme at SUPINFO Paris.'}</p>
      <p class="profile-biography">{locale === 'fr'
        ? 'Ce site rassemble 21 projets vérifiables, des notes techniques, une documentation pratique, un livre 3D de mathématiques et des essais.'
        : 'This site gathers 21 verifiable projects, technical notes, practical documentation, a 3D mathematics book and essays.'}</p>
      <div class="quick-links" aria-label={locale === 'fr' ? 'Liens rapides' : 'Quick links'}>
        <a href={`mailto:${site.email}`}>Email</a>
        <span>/</span>
        <a href={site.github}>GitHub</a>
        <span>/</span>
        <a href={site.linkedin}>LinkedIn</a>
        <span>/</span>
        <a href={withBase(`/${locale}/books/`)}>{copy.nav.books}</a>
        <span>/</span>
        <a href={withBase(`/${locale}/about/`)}>{locale === 'fr' ? 'Profil complet' : 'Full profile'}</a>
      </div>
    </div>
    <figure class="profile-hero-photo">
      <img src={profilePhoto.src} width={profilePhoto.width} height={profilePhoto.height} alt={locale === 'fr' ? `Portrait de ${site.name}` : `Portrait of ${site.name}`} />
    </figure>
  </section>

  <section class="section wrap" id="news">
    <h2 class="academic-h2">{copy.news}</h2>
    <ul class="news-list">
      {news.map(([date, text, href]) => (
        <li>
          <span class="meta">{date}</span>
          <a href={href}>{text}</a>
        </li>
      ))}
    </ul>
  </section>

  <section class="section wrap" id="education">
    <h2 class="academic-h2">{copy.education}</h2>
    <div class="education-list academic-education">
      <article>
        <time>2025 — 2027</time>
        <img src={withBase('/assets/school-supinfo-paris.png')} alt="SUPINFO Paris" />
        <div>
          <h3>Master Systems & Networks</h3>
          <p>SUPINFO Paris</p>
          <span>{locale === 'fr' ? 'Cloud · Systèmes · Réseaux · DevOps · Cybersécurité' : 'Cloud · Systems · Networks · DevOps · Cybersecurity'}</span>
        </div>
      </article>
      <article>
        <time>{locale === 'fr' ? 'Cycle ingénieur' : 'Engineering cycle'}</time>
        <img src={withBase('/assets/school-ecam-epmi.png')} alt="ECAM EPMI" />
        <div>
          <h3>{locale === 'fr' ? 'Formation d’ingénieur multidisciplinaire' : 'Multidisciplinary engineering programme'}</h3>
          <p>ECAM EPMI</p>
          <span>{locale === 'fr' ? 'Informatique · Électronique · Embarqué · Cloud · Gestion de projet' : 'Software · Electronics · Embedded · Cloud · Project management'}</span>
        </div>
      </article>
    </div>
  </section>

  <PlanetPanel locale={locale} />

  <section class="section wrap" id="projects">
    <div class="academic-section-head">
      <h2 class="academic-h2">{copy.selectedProjects}</h2>
      <a class="text-cta" href={withBase(`/${locale}/work/`)}>{locale === 'fr' ? 'Catalogue complet →' : 'Full catalogue →'}</a>
    </div>
    <AcademicProjectList entries={selectedProjects} locale={locale} />
  </section>

  <section class="section wrap" id="book">
    <div class="academic-section-head">
      <h2 class="academic-h2">{copy.bookSection}</h2>
      <a class="text-cta" href={withBase(`/${locale}/books/`)}>{locale === 'fr' ? 'Tous les livres →' : 'All books →'}</a>
    </div>
    <div class="books-catalog">
      {books.map((book) => (
        <article class="book-card book-card-visual">
          <a class="book-card-cover" href={withBase(`/${locale}/books/${book.slug}/`)} aria-label={book.title[locale]}>
            <img src={withBase(book.cover[locale])} width="960" height="1440" alt={book.title[locale]} loading="lazy" />
          </a>
          <div>
            <h3>{book.title[locale]}</h3>
            <p>{book.subtitle[locale]}</p>
            <p class="meta">{book.status[locale]}</p>
            <div class="quick-links">
              <a href={withBase(`/${locale}/books/${book.slug}/`)}>{book.kind === 'interactive' ? copy.readInteractive : copy.readPdf}</a>
              {book.kind === 'interactive' && book.demo ? (
                <>
                  <span>/</span>
                  <a href={withBase(book.demo)}>{locale === 'fr' ? 'Plein écran' : 'Full screen'}</a>
                </>
              ) : (
                <>
                  <span>/</span>
                  <a href={withBase(book.pdf.fr)}>Français</a>
                  <span>/</span>
                  <a href={withBase(book.pdf.en)}>English</a>
                  <span>/</span>
                  <a href={withBase(book.pdf.zh)}>中文</a>
                </>
              )}
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section wrap academic-resources-inline">
    <div class="resource-columns">
      <div id="articles">
        <h2 class="academic-h2">{copy.writing}</h2>
        <div class="academic-index-list">
          {articles.map((article, index) => (
            <a href={withBase(`/${locale}/journal/${entrySlug(article)}/`)}>
              <span>{String(index + 1).padStart(2, '0')}</span>
              <div>
                <strong>{article.data.title}</strong>
                <small>{article.data.readingTime} · {article.data.tags.join(' · ')}</small>
              </div>
              <i>↗</i>
            </a>
          ))}
        </div>
        <a class="text-cta" href={withBase(`/${locale}/journal/`)}>{locale === 'fr' ? 'Tous les articles →' : 'All writing →'}</a>
      </div>
      <div id="documentation">
        <h2 class="academic-h2">{copy.documentation}</h2>
        <div class="academic-index-list">
          {docs.map((doc, index) => (
            <a href={withBase(`/${locale}/docs/${entrySlug(doc)}/`)}>
              <span>{String(index + 1).padStart(2, '0')}</span>
              <div>
                <strong>{doc.data.title}</strong>
                <small>{doc.data.readingTime} · {doc.data.tags.join(' · ')}</small>
              </div>
              <i>↗</i>
            </a>
          ))}
        </div>
        <a class="text-cta" href={withBase(`/${locale}/docs/`)}>{locale === 'fr' ? 'Toute la documentation →' : 'All documentation →'}</a>
      </div>
    </div>
  </section>

</BaseLayout>
