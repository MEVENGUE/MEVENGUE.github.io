---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { locales, t, type Locale } from '@/i18n';
import { site } from '@/config/site';
import { withBase } from '@/lib/url';

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}
const locale = Astro.params.locale as Locale;
const copy = t(locale);
---
<BaseLayout locale={locale} title={copy.nav.contact} description={locale === 'fr' ? `Contacter ${site.name} à ${site.location}.` : `Contact ${site.name} in ${site.location}.`}>
  <header class="page-hero academic-page-hero">
    <div class="wrap">
      <h1>{copy.nav.contact}</h1>
      <p class="lead">{locale === 'fr'
        ? 'Pour une opportunité, une collaboration technique ou une question sur mes travaux, l’email est le moyen le plus direct.'
        : 'For an opportunity, technical collaboration or a question about my work, email is the most direct way.'}</p>
      <div class="quick-links">
        <a href={`mailto:${site.email}`}>{site.email}</a>
        <span>/</span>
        <a href={site.linkedin}>LinkedIn</a>
        <span>/</span>
        <a href={site.github}>GitHub</a>
        <span>/</span>
        <a href={withBase(`/${locale}/books/`)}>{copy.nav.books}</a>
      </div>
    </div>
  </header>

  <section class="section wrap">
    <h2 class="academic-h2">{locale === 'fr' ? 'Disponibilités' : 'Opportunities'}</h2>
    <p class="profile-biography">{locale === 'fr'
      ? 'Je suis disponible pour discuter d’une alternance, d’un stage ou d’une collaboration en lien avec le cloud, les systèmes, les réseaux, le DevOps, la cybersécurité et l’automatisation.'
      : 'I welcome conversations about apprenticeships, internships or collaborations related to cloud, systems, networking, DevOps, cybersecurity and automation.'}</p>
    <p class="profile-biography">{locale === 'fr'
      ? 'Présentez brièvement le contexte, les objectifs et l’échéance envisagée afin que je puisse répondre de façon précise.'
      : 'Please briefly describe the context, goals and expected timeline so I can reply with focus.'}</p>
    <div class="contact-directory" aria-label={locale === 'fr' ? 'Coordonnées' : 'Contact details'}>
      <a href={`mailto:${site.email}`}><span>Email</span><strong>{site.email}</strong><i>↗</i></a>
      <a href={site.linkedin} rel="me"><span>LinkedIn</span><strong>{locale === 'fr' ? 'Profil professionnel' : 'Professional profile'}</strong><i>↗</i></a>
      <a href={site.github} rel="me"><span>GitHub</span><strong>MEVENGUE</strong><i>↗</i></a>
      <div><span>{locale === 'fr' ? 'Localisation' : 'Location'}</span><strong>{site.location}</strong></div>
    </div>
  </section>
</BaseLayout>
