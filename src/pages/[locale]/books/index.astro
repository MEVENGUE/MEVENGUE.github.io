---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { locales, t, type Locale } from '@/i18n';
import { site } from '@/config/site';
import { withBase } from '@/lib/url';

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}
const locale = Astro.params.locale as Locale;
const copy = t(locale);
const books = site.books;
---
<BaseLayout
  locale={locale}
  title={copy.nav.books}
  description={locale === 'fr'
    ? 'Essais de Franck Mevengue : souveraineté du cloud européen et IA.'
    : 'Essays by Franck Mevengue: European cloud sovereignty and AI.'}
>
  <header class="page-hero academic-page-hero">
    <div class="wrap">
      <p class="eyebrow">{copy.bookSection}</p>
      <h1>{copy.nav.books}</h1>
      <p class="lead">{locale === 'fr'
        ? 'Un livre pop-up 3D et deux essais — à feuilleter, lire en PDF, en français, anglais et chinois.'
        : 'A 3D pop-up book and two essays — to leaf through or read as PDFs, in French, English and Chinese.'}</p>
    </div>
  </header>

  <section class="section wrap books-catalog">
    {books.map((book) => (
      <article class="book-card book-card-visual">
        <a class="book-card-cover" href={withBase(`/${locale}/books/${book.slug}/`)} aria-label={book.title[locale]}>
          <img src={withBase(book.cover[locale])} width="960" height="1440" alt={book.title[locale]} loading="lazy" />
        </a>
        <div>
          <p class="meta">{book.year} · {book.status[locale]}</p>
          <h2>{book.title[locale]}</h2>
          <p>{book.subtitle[locale]}</p>
          <div class="quick-links">
            <a href={withBase(`/${locale}/books/${book.slug}/`)}>{locale === 'fr' ? 'Ouvrir la page' : 'Open page'}</a>
            {book.kind === 'interactive' && book.demo ? (
              <>
                <span>/</span>
                <a href={withBase(book.demo)}>{copy.readInteractive}</a>
              </>
            ) : (
              <>
                <span>/</span>
                <a href={withBase(book.pdf.fr)}>Français</a>
                <span>/</span>
                <a href={withBase(book.pdf.en)}>English</a>
                <span>/</span>
                <a href={withBase(book.pdf.zh)}>中文</a>
              </>
            )}
          </div>
        </div>
      </article>
    ))}
  </section>
</BaseLayout>
